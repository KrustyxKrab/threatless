---
import { QUESTIONS, QUESTION_GROUPS, SCALE } from '@/data/questions';
import { CSF } from '@/data/csf';

const groups = Object.entries(QUESTION_GROUPS) as [
  keyof typeof QUESTION_GROUPS,
  (typeof QUESTION_GROUPS)[keyof typeof QUESTION_GROUPS],
][];
---

<div class="kq-split kq-split--wide" data-check>
  <form class="sw-form" aria-label="Organisation self-check">
    {
      groups.map(([key, g], gIdx) => (
        <fieldset class="sw-form__fieldset" style="margin-bottom: 2rem">
          <legend class="kq-h2" style="margin-bottom: 0.25rem">
            0{gIdx + 1}. {g.title}
          </legend>
          <p style="font-size: 0.92rem; color: var(--kq-ink-muted); margin-bottom: 1rem">{g.goal}</p>
          {QUESTIONS.filter((q) => q.group === key).map((q) => (
            <div class="kq-question">
              <p class="kq-question__text" id={`q-${q.id}`} style="font-weight:700; font-size:0.95rem">
                {q.text}
              </p>
              <div class="kq-scale" role="radiogroup" aria-labelledby={`q-${q.id}`}>
                {SCALE.map((s) => (
                  <label>
                    <input type="radio" name={q.id} value={s.value} />
                    <span>{s.label}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>
      ))
    }
  </form>

  <aside class="kq-panel" style="position:sticky; top:6rem; display:grid; gap:1rem" aria-live="polite">
    <div>
      <p class="kq-eyebrow">How ready is your team?</p>
      <p class="kq-score" style="margin-top:0.25rem" data-total>
        0%
      </p>
    </div>

    <div data-gaps>
      {
        CSF.map((f) => (
          <div class="kq-gap" data-gap={f.id}>
            <span>{f.label}</span>
            <div class="kq-progress">
              <div class="kq-progress__bar" style={`background:${f.color}`} />
            </div>
            <span data-pct>–</span>
          </div>
        ))
      }
    </div>

    <div class="kq-callout kq-callout--teal">
      <p class="kq-eyebrow" style="color:var(--kq-ink)">Priority Focus</p>
      <p style="font-size:0.9rem; font-weight:700; margin-top:0.2rem" data-hint>
        Rate each question (“Not yet”, “Partly”, or “Yes”) to see where your biggest security gap is.
      </p>
    </div>

    <a class="kq-btn kq-btn--primary" href="/learn/" data-hint-link hidden style="width:100%">
      <span data-hint-link-text>Recommended action</span>
      <span aria-hidden="true">→</span>
    </a>
  </aside>
</div>

<script>
  import { QUESTIONS, MAX_SCORE } from '@/data/questions';
  import { CSF } from '@/data/csf';
  import { load, update } from '@/lib/storage';

  const root = document.querySelector<HTMLElement>('[data-check]');
  if (root) {
    const checkRoot = root;
    const form = checkRoot.querySelector('form')!;
    const hintLink = checkRoot.querySelector<HTMLAnchorElement>('[data-hint-link]');
    const hintLinkText = checkRoot.querySelector<HTMLElement>('[data-hint-link-text]');

    function render(answers: Record<string, number>) {
      const total = Object.values(answers).reduce((a, b) => a + b, 0);
      checkRoot.querySelector('[data-total]')!.textContent = `${Math.round((total / MAX_SCORE) * 100)}%`;

      let weakest: { label: string; pct: number; link: { label: string; href: string } } | null = null;
      for (const f of CSF) {
        const qs = QUESTIONS.filter((q) => q.csf === f.id);
        const answered = qs.filter((q) => q.id in answers);
        const row = checkRoot.querySelector<HTMLElement>(`[data-gap="${f.id}"]`)!;
        if (!qs.length || !answered.length) continue;
        const pct = Math.round((answered.reduce((a, q) => a + answers[q.id], 0) / (qs.length * 2)) * 100);
        row.querySelector<HTMLElement>('.kq-progress__bar')!.style.setProperty('--value', `${pct}%`);
        row.querySelector('[data-pct]')!.textContent = `${pct}%`;
        if (!weakest || pct < weakest.pct) {
          weakest = { label: f.label, pct, link: f.links[0] };
        }
      }
      if (weakest) {
        checkRoot.querySelector('[data-hint]')!.textContent =
          `Largest gap: ${weakest.label} (${weakest.pct}%). Start here for the highest impact.`;
        if (hintLink && hintLinkText) {
          hintLink.href = weakest.link.href;
          hintLinkText.textContent = `Recommended next step: ${weakest.link.label}`;
          hintLink.hidden = false;
        }
      }
    }

    const saved = load().check;
    for (const [id, v] of Object.entries(saved)) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="${id}"][value="${v}"]`);
      if (radio) radio.checked = true;
    }
    render(saved);

    form.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      render(update((p) => (p.check[input.name] = Number(input.value))).check);
    });
  }
</script>
