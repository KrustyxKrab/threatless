---
import { NAV, SITE } from '@/data/site';
import Icon from '@/components/ui/Icon.astro';
import LevelChip from './LevelChip.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="kq-header">
  <div class="sw-container kq-header__inner">
    <a class="kq-brand" href="/" aria-label={`${SITE.org} ${SITE.name} – home`}>
      <span class="kq-brand__org">{SITE.org}</span>
      <span class="kq-brand__product">Threat<i>less</i></span>
    </a>

    <nav class="kq-nav" aria-label="Main navigation">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="kq-header__tools">
      <LevelChip />
    </div>
  </div>
</header>

<nav class="kq-nav-mobile" aria-label="App navigation">
  {
    NAV.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        <span class="kq-nav-mobile__icon"><Icon name={item.icon} /></span>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>
