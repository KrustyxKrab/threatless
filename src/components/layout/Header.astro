---
import { NAV, SITE } from '@/data/site';
import { ROLES } from '@/data/game';
import Icon from '@/components/ui/Icon.astro';
import LevelChip from './LevelChip.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="kq-header">
  <div class="sw-container kq-header__inner">
    <a class="kq-brand" href="/" aria-label={`${SITE.org} ${SITE.name} – home`}>
      <span class="kq-brand__org">{SITE.org}</span>
      <span class="kq-brand__product">Krise<i>·</i>Quartett</span>
    </a>

    <nav class="kq-nav" aria-label="Main navigation">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{item.label}</span>
          </a>
        ))
      }
    </nav>

    <div class="kq-header__tools">
      <div class="kq-role-switch" role="group" aria-label="Select your role">
        {
          ROLES.map((r) => (
            <button type="button" data-header-role={r.id} aria-pressed="false" title={r.hint}>
              {r.label}
            </button>
          ))
        }
      </div>
      <LevelChip />
    </div>
  </div>
</header>

<nav class="kq-nav-mobile" aria-label="App navigation">
  {
    NAV.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
        <span class="kq-nav-mobile__icon"><Icon name={item.icon} /></span>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<script>
  import type { Role } from '@/data/game';
  import { update, watch } from '@/lib/storage';

  const roleBtns = document.querySelectorAll<HTMLButtonElement>('[data-header-role]');
  roleBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const role = btn.dataset.headerRole as Role;
      update((p) => {
        p.role = p.role === role ? null : role;
      });
    });
  });

  watch((p) => {
    roleBtns.forEach((btn) => {
      const active = (p.role ?? 'volunteer') === btn.dataset.headerRole;
      btn.setAttribute('aria-pressed', String(active));
    });
  });
</script>
