---
import { SITE } from '@/data/site';
import RoleSwitch from './RoleSwitch.astro';
---

<footer class="kq-footer">
  <div class="sw-container kq-footer__inner">
    <span><strong>{SITE.name}</strong> by {SITE.org}</span>
    <RoleSwitch />
    <button type="button" class="kq-footer__reset" data-reset-progress>Reset my progress</button>
  </div>
</footer>

<script>
  import { reset } from '@/lib/storage';

  document.querySelector<HTMLButtonElement>('[data-reset-progress]')?.addEventListener('click', () => {
    if (confirm('Reset your points and progress on this device?')) reset();
  });
</script>
