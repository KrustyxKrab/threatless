---
import ModuleCard from './ModuleCard.astro';
import { MODULES } from '@/data/modules';
---

<ol class="kq-module-list" style="list-style:none; padding:0; margin:0">
  {MODULES.map((m, idx) => <li><ModuleCard module={m} index={idx} /></li>)}
</ol>

<script>
  import { paintModuleChip, isRequired } from '@/lib/progress';
  import { watch } from '@/lib/storage';

  const moduleCards = [...document.querySelectorAll<HTMLElement>('[data-module]')];
  watch((p) => {
    let markedNext = false;
    for (const card of moduleCards) {
      const done = Boolean(p.modules[card.dataset.module ?? '']);
      const isNext = !done && isRequired(card, p) && !markedNext;
      if (isNext) markedNext = true;
      paintModuleChip(card, p, isNext);
    }
  });
</script>
