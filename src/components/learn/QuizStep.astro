---
import type { QuizItem } from '@/data/modules';
import MessageMock from './MessageMock.astro';

interface Props {
  item: QuizItem;
  index: number;
  count: number;
}
const { item: q, index, count } = Astro.props;
---

<section data-step data-quiz hidden>
  <p class="kq-eyebrow">Practice {index + 1} of {count}</p>
  <h1 class="kq-h2" tabindex="-1" data-step-title style="margin-block:0.75rem 1.25rem">{q.prompt}</h1>

  {q.message && <MessageMock message={q.message} signs={q.signs} />}

  <p style="font-weight:700; margin-top:1.5rem">What do you think?</p>
  <div class:list={['kq-options', q.options.length === 2 && 'kq-options--2']}>
    {
      q.options.map((opt, i) => (
        <button type="button" class="kq-option" data-option data-correct={i === q.answer ? '' : undefined}>
          {opt}
        </button>
      ))
    }
  </div>

  <div class="kq-feedback" data-feedback hidden role="status">
    <p data-feedback-heading style="font-weight:800; font-size:1.1rem; margin-bottom:0.35rem"></p>
    <p>{q.explain}</p>
    {
      q.signs && (
        <ul style="margin:0.75rem 0 0; padding-left:1.2rem">
          {q.signs.map((s) => <li>{s}</li>)}
        </ul>
      )
    }
    <div style="margin-top:1.25rem">
      <button type="button" class="kq-btn kq-btn--primary" data-next>
        {index === count - 1 ? 'See my result' : 'Next example'} <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>
