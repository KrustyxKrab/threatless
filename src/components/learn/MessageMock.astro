---
import type { Channel, Message } from '@/data/modules';
import { WARNING_SIGNS } from '@/data/signs';

interface Props {
  message: Message;
}
const { message } = Astro.props;

const CHANNEL: Record<Channel, string> = {
  email: 'E-mail',
  sms: 'Text message',
  call: 'Phone call',
  social: 'Social media comment',
  chat: 'Chat message',
  story: 'Instagram story',
};
const isStory = message.channel === 'story';
---

{
  isStory ? (
    <figure class="kq-story" aria-label="Example Instagram story">
      <div class="kq-story__bar"><span /></div>
      <div class="kq-story__head">
        <span class="kq-story__avatar" aria-hidden="true" />
        <strong>{message.from}</strong>
        <span>Sponsored</span>
      </div>
      <p class="kq-story__text">{message.body}</p>
      <span class="kq-story__swipe">Swipe up ↑</span>
    </figure>
  ) : (
    <figure class="kq-mail-client" style="margin:0" aria-label={`Example ${CHANNEL[message.channel].toLowerCase()}`}>
      <div class="kq-mail-client__chrome">{CHANNEL[message.channel]}</div>
      <dl class="kq-mail-client__meta" style="margin:0">
        <dt>From</dt>
        <dd>{message.from}</dd>
        {message.subject && (<><dt>Subject</dt><dd>{message.subject}</dd></>)}
      </dl>
      <div class="kq-mail-client__body">{message.body}</div>
    </figure>
  )
}

<details class="kq-hint">
  <summary>Not sure? Check the 4 warning signs</summary>
  <ol>
    {WARNING_SIGNS.map((s) => <li><strong>{s.title}.</strong> {s.ask}</li>)}
  </ol>
</details>
