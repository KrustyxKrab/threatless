---
import { INCIDENTS } from '@/data/incidents';
import Illo from '@/components/ui/Illo.astro';

const URGENCY = { red: 'Urgent', yellow: 'Be careful', green: 'Low' } as const;
const first = INCIDENTS[0];
---

<div class="kq-split kq-split--wide" data-incident-reporter>
  <section class="kq-journey-step" aria-labelledby="step1">
    <div class="kq-journey-step__head">
      <span class="kq-journey-step__num" aria-hidden="true">1</span>
      <h2 id="step1" class="kq-h3">What happened?</h2>
    </div>
    <div style="display:grid; gap:0.6rem" role="group" aria-label="Choose what happened">
      {
        INCIDENTS.map((inc) => (
          <button type="button" class="kq-incident-item" data-incident-btn={inc.id} data-urgency={inc.level} aria-pressed={inc.id === first.id ? 'true' : 'false'}>
            <span class="kq-incident-item__title">{inc.title}</span>
            <span class="kq-incident-hint">{URGENCY[inc.level]} · {inc.hint}</span>
          </button>
        ))
      }
    </div>
  </section>

  <div style="display:grid; gap:2.5rem" data-incident-detail>
    <section class="kq-journey-step" aria-labelledby="step2" aria-live="polite">
      <div class="kq-journey-step__head">
        <span class="kq-journey-step__num" aria-hidden="true">2</span>
        <h2 id="step2" class="kq-h3">Do this now</h2>
        <span class="kq-badge" data-detail-progress style="margin-left:auto">0 / {first.checklist.length}</span>
      </div>
      <p class="kq-muted" data-detail-title>{first.title}</p>
      <div data-detail-checklist></div>
      <div class="kq-callout kq-callout--warn">
        <p style="font-weight:800">Please don’t:</p>
        <ul data-detail-avoid style="margin:0.35rem 0 0; padding-left:1.2rem"></ul>
      </div>
    </section>

    <section class="kq-journey-step" aria-labelledby="step3">
      <div class="kq-journey-step__head">
        <span class="kq-journey-step__num" aria-hidden="true">3</span>
        <h2 id="step3" class="kq-h3">Tell your coordinator</h2>
      </div>
      <p class="kq-muted">Copy the short report and send it to your coordinator in your team chat or by e-mail.</p>
      <form data-report-form style="display:grid; gap:0.85rem">
        <label style="display:grid; gap:0.35rem">
          <span style="font-weight:700">What happened, and when? <span class="kq-muted" style="font-weight:400">(optional)</span></span>
          <textarea
            name="note"
            rows="3"
            maxlength="1000"
            style="padding:0.75rem; border:var(--kq-border-std); border-radius:var(--kq-radius); background:var(--kq-surface); font:inherit"
            placeholder="e.g. Got an invoice e-mail at 14:20. I did not open the file."></textarea>
        </label>
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:0.5rem 1.25rem">
          <button type="button" class="kq-btn kq-btn--primary kq-btn--lg" data-copy-report>Copy report</button>
          <button type="submit" class="kq-btn kq-btn--ghost">Save a copy for me</button>
        </div>
        <p class="kq-callout kq-callout--teal" data-report-feedback hidden role="status"></p>
      </form>
    </section>

    <section class="kq-report-done" data-report-done hidden aria-labelledby="done-title" tabindex="-1">
      <Illo name="done" width={140} class="kq-report-done__art" decorative />
      <h2 id="done-title" class="kq-h2">Done. You did the right thing.</h2>
      <p>Reporting fast is the most important step – and you did it.</p>
      <ol class="kq-steps" style="margin:0">
        <li><span>Send the copied report to your coordinator now (team chat or e-mail).</span></li>
        <li><span>They check it and may change the team alert level – you’ll see it at the top of the app.</span></li>
        <li><span>Until then: don’t click, don’t reply, keep an eye out for similar messages.</span></li>
      </ol>
      <div style="display:flex; flex-wrap:wrap; gap:0.5rem 1.25rem; align-items:center">
        <a class="kq-btn kq-btn--primary kq-btn--lg" href="/">Back to start <span aria-hidden="true">→</span></a>
        <a class="kq-btn kq-btn--ghost" href="/status/">See the alert level</a>
      </div>
    </section>
  </div>
</div>

<script>
  import { INCIDENTS, type Incident } from '@/data/incidents';
  import { update } from '@/lib/storage';

  const root = document.querySelector<HTMLElement>('[data-incident-reporter]');
  if (root) {
    let active: Incident = INCIDENTS[0];
    let checked = new Set<number>();

    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-incident-btn]');
    const progressChip = root.querySelector<HTMLElement>('[data-detail-progress]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-detail-title]')!;
    const checklistEl = root.querySelector<HTMLElement>('[data-detail-checklist]')!;
    const avoidEl = root.querySelector<HTMLElement>('[data-detail-avoid]')!;
    const form = root.querySelector<HTMLFormElement>('[data-report-form]')!;
    const note = form.elements.namedItem('note') as HTMLTextAreaElement;
    const feedback = root.querySelector<HTMLElement>('[data-report-feedback]')!;

    const doneEl = root.querySelector<HTMLElement>('[data-report-done]')!;
    const say = (msg: string) => {
      feedback.textContent = msg;
      feedback.hidden = false;
    };
    const finish = () => {
      doneEl.hidden = false;
      doneEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      doneEl.focus({ preventScroll: true });
    };

    function updateCounter() {
      const all = checked.size === active.checklist.length;
      progressChip.textContent = all ? 'All done' : `${checked.size} / ${active.checklist.length}`;
      progressChip.className = all ? 'kq-badge kq-badge--done' : 'kq-badge';
    }

    function checkRow(item: string, i: number): HTMLLabelElement {
      const label = document.createElement('label');
      label.className = 'kq-check';
      const box = document.createElement('input');
      box.type = 'checkbox';
      box.addEventListener('change', () => {
        if (box.checked) checked.add(i);
        else checked.delete(i);
        updateCounter();
      });
      const text = document.createElement('span');
      text.textContent = item;
      label.append(box, text);
      return label;
    }

    function renderActive() {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.incidentBtn === active.id)));
      titleEl.textContent = active.title;
      checklistEl.replaceChildren(...active.checklist.map(checkRow));
      avoidEl.replaceChildren(
        ...active.avoid.map((a) => {
          const li = document.createElement('li');
          li.textContent = a;
          return li;
        })
      );
      updateCounter();
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const found = INCIDENTS.find((x) => x.id === btn.dataset.incidentBtn);
        if (!found) return;
        active = found;
        checked = new Set<number>();
        feedback.hidden = true;
        doneEl.hidden = true;
        renderActive();
        if (window.innerWidth < 1024) root.querySelector('[data-incident-detail]')?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    root.querySelector<HTMLButtonElement>('[data-copy-report]')?.addEventListener('click', async () => {
      const done = active.checklist.filter((_, i) => checked.has(i));
      const text = [
        `Security report: ${active.title}`,
        `Done so far: ${done.length ? done.join('; ') : 'nothing yet'}`,
        `Details: ${note.value.trim() || '–'}`,
      ].join('\n');
      try {
        await navigator.clipboard.writeText(text);
        say('✓ Copied. Paste it into your team chat or an e-mail to your coordinator.');
        finish();
      } catch {
        say(`Copying didn’t work here. Please copy this text by hand:\n\n${text}`);
        finish();
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      update((p) => {
        p.reports.unshift({
          id: `rep-${Date.now().toString(36)}`,
          type: active.title,
          at: Date.now(),
          done: [...checked],
          note: note.value.trim(),
        });
      });
      say('✓ Saved on this device. Please still send it to your coordinator.');
      finish();
    });

    renderActive();
  }
</script>
