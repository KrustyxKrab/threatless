---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PointsCard from '@/components/learn/PointsCard.astro';
import LearnPath from '@/components/learn/LearnPath.astro';
---

<BaseLayout title="Learn">
  <div style="display:grid; gap:1rem; max-width:560px; margin-inline:auto">
    <h1 class="kq-h1">Your path</h1>
    <p class="kq-muted">Each step: read a little, then decide if real-looking messages are safe. Every right answer gives 10 points.</p>
    <PointsCard />
  </div>
  <LearnPath />
</BaseLayout>
