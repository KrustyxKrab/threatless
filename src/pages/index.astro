---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LearnTile from '@/components/home/LearnTile.astro';
import HelpTile from '@/components/home/HelpTile.astro';
import Illo from '@/components/ui/Illo.astro';
---

<BaseLayout>
  <div class="kq-home-hero">
    <div style="display:grid; gap:0.75rem">
      <h1 class="kq-display">Spot scams.<br />Get help fast.</h1>
      <p class="kq-lead">Learn the warning signs in short games – and know exactly what to do when something goes wrong.</p>
    </div>
    <Illo name="hero" width={260} class="kq-home-hero__art" eager decorative />
  </div>

  <div class="kq-modes">
    <LearnTile />
    <HelpTile />
  </div>
</BaseLayout>
